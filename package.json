{
  "name": "github-view",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs scripts/serve.test.mjs",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-check.mjs",
    "startup:install": "node scripts/startup.mjs install",
    "startup:uninstall": "node scripts/startup.mjs uninstall",
    "startup:status": "node scripts/startup.mjs status",
    "format": "prettier --write src scripts tests package.json index.html github-digest.html CLAUDE.md README.md github-digest.map.md github-digest.md docs playwright.config.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "lucide-preact": "^1.42.0",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6",
    "vite": "^7.1.0"
  }
}
