<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github-view.watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>-u</string>
    <string>GH_TOKEN</string>
    <string>-u</string>
    <string>GITHUB_TOKEN</string>
    <string>-u</string>
    <string>GH_HOST</string>
    <string>-u</string>
    <string>GH_CONFIG_DIR</string>
    <string>/path/to/node</string>
    <string>/path/to/github-view/.gh-digest/watch.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/github-view</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/you</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <!-- Optional: restrict watcher queries to a single GitHub organization -->
    <!-- <key>GH_DIGEST_ORG</key><string>your-org</string> -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>/path/to/github-view/.gh-digest/watch.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/github-view/.gh-digest/watch.log</string>
</dict>
</plist>
